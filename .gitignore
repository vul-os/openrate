# Go
/openrate
*.test
*.out

# Node / Vite
web/node_modules/
web/.vite/

# Playwright (E2E boot guard) output
web/test-results/
# Playwright writes .last-run.json relative to the CWD it was invoked from, so
# a run started at the repo root drops one here rather than under web/.
/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# web/dist is committed (the built UI is embedded into the binary so a clone is
# self-contained); regenerate with `npm --prefix web run build`.

# Local
.env
*.log
.DS_Store

# Release staging directory (built in CI; the SHA256SUMS manifest covers it)
/release/
