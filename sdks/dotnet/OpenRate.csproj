<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>VulOs.OpenRate</PackageId>
    <Version>0.1.8</Version>
    <Description>Currency and interest rates with provenance — embedded, or as a local sidecar.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://vulos.org/projects/openrate/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vul-os/openrate</RepositoryUrl>
    <PackageTags>currency;exchange-rates;fx;forex;interest-rates</PackageTags>
    <!--
      LibraryImport requires this UNCONDITIONALLY: the source generator emits
      pointer-using marshalling stubs even for a signature that declares none,
      and refuses to compile without it (SYSLIB1062). It was worth finding out
      by building rather than by asserting — the first version of this file
      claimed the binding needed no unsafe, and the compiler disagreed.

      What IS true, and is the honest form of that claim: openrate's C ABI has
      no callback, so nothing in OpenRateDirect.cs uses a pointer, a function
      pointer or a fixed buffer. `char**` is expressed as `out IntPtr`. Only
      the generated stubs are unsafe. llmux's .NET SDK writes unsafe code of
      its own, because llmux_stream takes a function pointer.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Keep the examples out of the library compilation. -->
  <ItemGroup>
    <Compile Remove="examples/**/*.cs" />
    <None Remove="examples/**" />
  </ItemGroup>

  <!-- Ship the bundled binary if present (gitignored in this repo). -->
  <ItemGroup>
    <None Include="bin/**" Pack="true" PackagePath="contentFiles/any/any/bin" Condition="Exists('bin')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
