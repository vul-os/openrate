# Go
/openrate
*.test
*.out

# web/node_modules is stale leftover from the retired Vite/React toolchain
# (the UI is now a single hand-written web/ui.html — no npm, no build step)
# and is removed separately; ignored here so it can never be committed.
web/node_modules/

# Local — every .env variant except the checked-in template. Was an exact-match
# `.env` only, so `.env.local` / `.env.bak` / `.env.production` (real paid-API
# keys per .env.example: OXR/Twelve Data/Polygon/TraderMade/FRED) were untracked
# but not ignored — one `git add -A` away from being committed.
.env
.env.*
!.env.example
*.log
.DS_Store

# Release staging directory (built in CI; the SHA256SUMS manifest covers it)
/release/

# Shared-library build output (scripts/build-ffi.sh). Built per platform by
# whoever has the toolchain; never committed.
/dist/
