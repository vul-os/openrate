# Go
/openrate
*.test
*.out

# Node / Vite
web/node_modules/
web/.vite/

# Playwright (E2E boot guard) output
web/test-results/
# Playwright writes .last-run.json relative to the CWD it was invoked from, so
# a run started at the repo root drops one here rather than under web/.
/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# web/dist is committed (the built UI is embedded into the binary so a clone is
# self-contained); regenerate with `npm --prefix web run build`.

# Local — every .env variant except the checked-in template. Was an exact-match
# `.env` only, so `.env.local` / `.env.bak` / `.env.production` (real paid-API
# keys per .env.example: OXR/Twelve Data/Polygon/TraderMade/FRED) were untracked
# but not ignored — one `git add -A` away from being committed.
.env
.env.*
!.env.example
*.log
.DS_Store

# Release staging directory (built in CI; the SHA256SUMS manifest covers it)
/release/
