<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenRate.Examples</RootNamespace>
    <AssemblyName>openrate-examples</AssemblyName>
    <!--
      Target net8.0 (the library's floor) but run on whatever runtime is
      installed. Without this, a machine carrying only the .NET 10 runtime
      refuses to start a net8.0 app — a packaging detail, not something an
      example should make you solve before you can read it.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenRate.csproj" />
  </ItemGroup>

</Project>
